{
  "name": "Fantasy Cric Sim",
  "short_name": "Cric Sim",
  "description": "A cricket simulator with teams from anime and games, and a career mode.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#07080d",
  "theme_color": "#07080d",
  "categories": ["games", "sports"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Career", "short_name": "Career", "url": "/career", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Play a match", "short_name": "Play", "url": "/play", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
